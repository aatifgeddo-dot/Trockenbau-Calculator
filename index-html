
<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Professional Calculator</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #eaf2fa, #ffffff);
    font-family: Arial, sans-serif;
    padding: 20px;
}

.calculator {
    width: 100%;
    max-width: 370px;
    background: #ffffff;
    padding: 25px;
    border-radius: 25px;
    box-shadow: 0 15px 45px rgba(11, 47, 91, 0.15);
    border: 1px solid #e3eaf2;
}

.header {
    text-align: center;
    margin-bottom: 22px;
}

.header h2 {
    color: #0b2f5b;
    font-size: 23px;
    letter-spacing: 1px;
}

.header p {
    color: #8997a8;
    font-size: 12px;
    margin-top: 6px;
}

.display {
    width: 100%;
    min-height: 110px;
    background: #f1f5fa;
    border-radius: 16px;
    margin-bottom: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    overflow: hidden;
}

.previous {
    color: #8290a1;
    font-size: 15px;
    min-height: 22px;
}

.current {
    color: #0b2f5b;
    font-size: 36px;
    font-weight: bold;
    max-width: 100%;
    overflow-wrap: anywhere;
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 11px;
}

button {
    height: 62px;
    border: none;
    border-radius: 14px;
    background: #edf3f9;
    color: #0b2f5b;
    font-size: 21px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
    box-shadow: 0 3px 6px rgba(11,47,91,0.05);
}

button:hover {
    background: #dce8f5;
    transform: translateY(-2px);
}

button:active {
    transform: scale(0.95);
}

.operator {
    background: #dce9f7;
    color: #0b2f5b;
}

.clear {
    background: #fbe8e9;
    color: #c51f24;
}

.delete {
    background: #fbe8e9;
    color: #c51f24;
}

.equal {
    background: #0b2f5b;
    color: white;
}

.equal:hover {
    background: #174a80;
}

.zero {
    grid-column: span 2;
}

.footer {
    text-align: center;
    color: #9aa7b5;
    font-size: 11px;
    margin-top: 20px;
}

@media (max-width: 400px) {
    .calculator {
        padding: 18px;
    }

    button {
        height: 57px;
    }
}
</style>
</head>

<body>

<div class="calculator">

    <div class="header">
        <h2>CALCULATOR</h2>
        <p>Professional Digital Calculator</p>
    </div>

    <div class="display">
        <div class="previous" id="previous"></div>
        <div class="current" id="current">0</div>
    </div>

    <div class="buttons">

        <button class="clear" onclick="clearAll()">AC</button>
        <button class="delete" onclick="deleteNumber()">DEL</button>
        <button class="operator" onclick="percentage()">%</button>
        <button class="operator" onclick="chooseOperator('/')">÷</button>

        <button onclick="appendNumber('7')">7</button>
        <button onclick="appendNumber('8')">8</button>
        <button onclick="appendNumber('9')">9</button>
        <button class="operator" onclick="chooseOperator('*')">×</button>

        <button onclick="appendNumber('4')">4</button>
        <button onclick="appendNumber('5')">5</button>
        <button onclick="appendNumber('6')">6</button>
        <button class="operator" onclick="chooseOperator('-')">−</button>

        <button onclick="appendNumber('1')">1</button>
        <button onclick="appendNumber('2')">2</button>
        <button onclick="appendNumber('3')">3</button>
        <button class="operator" onclick="chooseOperator('+')">+</button>

        <button class="zero" onclick="appendNumber('0')">0</button>
        <button onclick="appendDecimal()">.</button>
        <button class="equal" onclick="calculate()">=</button>

    </div>

    <div class="footer">
        Professional Calculator © 2026
    </div>

</div>

<script>

const currentDisplay = document.getElementById("current");
const previousDisplay = document.getElementById("previous");

let currentNumber = "0";
let previousNumber = null;
let operator = null;
let resetScreen = false;

function updateDisplay() {
    currentDisplay.textContent = currentNumber;
}

function appendNumber(number) {
    if (currentNumber === "Error") clearAll();

    if (resetScreen) {
        currentNumber = number;
        resetScreen = false;
    } else {
        currentNumber =
            currentNumber === "0" ? number : currentNumber + number;
    }

    updateDisplay();
}

function appendDecimal() {
    if (resetScreen) {
        currentNumber = "0";
        resetScreen = false;
    }

    if (!currentNumber.includes(".")) {
        currentNumber += ".";
    }

    updateDisplay();
}

function chooseOperator(op) {
    if (currentNumber === "Error") return;

    if (operator !== null && !resetScreen) {
        calculate();
    }

    previousNumber = parseFloat(currentNumber);
    operator = op;
    previousDisplay.textContent =
        previousNumber + " " + getSymbol(op);
    resetScreen = true;
}

function getSymbol(op) {
    return {
        "+": "+",
        "-": "−",
        "*": "×",
        "/": "÷"
    }[op];
}

function calculate() {
    if (operator === null || previousNumber === null) return;

    const secondNumber = parseFloat(currentNumber);
    let result;

    switch (operator) {
        case "+":
            result = previousNumber + secondNumber;
            break;
        case "-":
            result = previousNumber - secondNumber;
            break;
        case "*":
            result = previousNumber * secondNumber;
            break;
        case "/":
            if (secondNumber === 0) {
                currentNumber = "Error";
                previousDisplay.textContent = "Cannot divide by zero";
                operator = null;
                previousNumber = null;
                resetScreen = true;
                updateDisplay();
                return;
            }
            result = previousNumber / secondNumber;
            break;
    }

    previousDisplay.textContent =
        previousNumber + " " + getSymbol(operator) +
        " " + secondNumber + " =";

    currentNumber = String(
        Number.parseFloat(result.toPrecision(12))
    );

    operator = null;
    previousNumber = null;
    resetScreen = true;
    updateDisplay();
}

function percentage() {
    if (currentNumber === "Error") return;

    currentNumber = String(parseFloat(currentNumber) / 100);
    updateDisplay();
}

function deleteNumber() {
    if (currentNumber === "Error" || resetScreen) {
        currentNumber = "0";
        resetScreen = false;
    } else {
        currentNumber =
            currentNumber.length > 1
            ? currentNumber.slice(0, -1)
            : "0";
    }

    updateDisplay();
}

function clearAll() {
    currentNumber = "0";
    previousNumber = null;
    operator = null;
    resetScreen = false;
    previousDisplay.textContent = "";
    updateDisplay();
}

document.addEventListener("keydown", function(event) {
    if (event.key >= "0" && event.key <= "9") {
        appendNumber(event.key);
    }

    if (event.key === ".") appendDecimal();

    if (["+", "-", "*", "/"].includes(event.key)) {
        chooseOperator(event.key);
    }

    if (event.key === "Enter" || event.key === "=") {
        event.preventDefault();
        calculate();
    }

    if (event.key === "Backspace") deleteNumber();

    if (event.key === "Escape") clearAll();

    if (event.key === "%") percentage();
});

</script>

</body>
</html>
